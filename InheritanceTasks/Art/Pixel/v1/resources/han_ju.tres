properties = {"painter": "independent_music_stage", "art_status": "六身份逐格核对；等待引擎画面检查", "npc_atlas": "res://InheritanceTasks/Art/Pixel/v1/runtime/music-npcs.png", "source_record": "res://InheritanceTasks/Art/Pixel/v1/source/music-art-generation-log.json", "chart_review": "候选谱面尚未完成逐句听审；动作按游戏编排"}
