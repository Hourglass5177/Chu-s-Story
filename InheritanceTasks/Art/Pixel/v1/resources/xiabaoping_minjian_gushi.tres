[resource]
script = ExtResource("1")
background = ExtResource("bg")
cover = ExtResource("cover")
avatar_appearances = {&"travel_blogger": SubResource("avatar_travel"), &"life_blogger": SubResource("avatar_life"), &"business_blogger": SubResource("avatar_business"), &"food_blogger": SubResource("avatar_food"), &"adventure_blogger": SubResource("avatar_adventure"), &"magic_blogger": SubResource("avatar_magic")}
properties = {"painter": "story", "success_hint": "看完四幕，在30秒内按故事顺序排好；第一次排错可调整后再提交。", "art_status": "引擎检查中"}
source_manifest_path = "res://InheritanceTasks/Art/Pixel/v1/presentation-manifest.json"
story_panels = Array[Texture2D]([ExtResource("story_panels_0"), ExtResource("story_panels_1"), ExtResource("story_panels_2"), ExtResource("story_panels_3")])
story_thumbnails = Array[Texture2D]([ExtResource("story_thumbnails_0"), ExtResource("story_thumbnails_1"), ExtResource("story_thumbnails_2"), ExtResource("story_thumbnails_3")])
story_animation = Array[Texture2D]([ExtResource("story_animation_0"), ExtResource("story_animation_1"), ExtResource("story_animation_2"), ExtResource("story_animation_3"), ExtResource("story_animation_4"), ExtResource("story_animation_5"), ExtResource("story_animation_6"), ExtResource("story_animation_7"), ExtResource("story_animation_8"), ExtResource("story_animation_9"), ExtResource("story_animation_10"), ExtResource("story_animation_11")])
