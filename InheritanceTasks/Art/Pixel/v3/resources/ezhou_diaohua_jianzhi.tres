[sub_resource type="AtlasTexture" id="travel_0"]

atlas = ExtResource("travel")

region = Rect2(0,0,168,240)

filter_clip = true

[sub_resource type="AtlasTexture" id="travel_1"]

atlas = ExtResource("travel")

region = Rect2(168,0,168,240)

filter_clip = true

[sub_resource type="SpriteFrames" id="frames_travel"]

animations = [{"frames": [{"duration": 1.0, "texture": SubResource("travel_0")}], "loop": false, "name": &"ready", "speed": 1.0},
{"frames": [{"duration": 1.0, "texture": SubResource("travel_0")}], "loop": false, "name": &"idle", "speed": 1.0},
{"frames": [{"duration": 1.0, "texture": SubResource("travel_1")}], "loop": false, "name": &"wave", "speed": 1.0}]

[sub_resource type="Resource" id="appearance_travel"]

script = ExtResource("appearance")

avatar_id = &"travel_blogger"

costume_id = &"ezhou_diaohua_jianzhi"

portrait = ExtResource("portrait_travel")

atlas = ExtResource("travel")

sprite_frames = SubResource("frames_travel")

frame_size = Vector2i(168,240)

anchors = {&"feet": Vector2(84.0,240)}

reference_note = "原博主身份的生成衍生。此 SpriteFrames 仅含准备／岸边静态姿势；董永动作由独立接触点驱动生成拆件，剪纸由刀手组件驱动。故事会与岸边共享乡村体验服，文化人物独立。"

