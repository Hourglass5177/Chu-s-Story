[resource]

script = ExtResource("script")

pixel_canvas_size = Vector2i(1000, 600)

version = 3

background = ExtResource("bg")

cover = ExtResource("cover")

avatar_appearances = {&"travel_blogger": SubResource("appearance_travel"), &"life_blogger": SubResource("appearance_life"), &"business_blogger": SubResource("appearance_business"), &"food_blogger": SubResource("appearance_food"), &"adventure_blogger": SubResource("appearance_adventure"), &"magic_blogger": SubResource("appearance_magic")}

source_manifest_path = "res://InheritanceTasks/Art/Pixel/v3/paper-detail-manifest.json"

properties = {"native_pixel_scale": 1, "status": "generated candidate; actual scene review and user acceptance recorded separately"}

stage_scene = ExtResource("stage")

avatar_covers = {&"travel_blogger": ExtResource("identity_cover_travel"), &"life_blogger": ExtResource("identity_cover_life"), &"business_blogger": ExtResource("identity_cover_business"), &"food_blogger": ExtResource("identity_cover_food"), &"adventure_blogger": ExtResource("identity_cover_adventure"), &"magic_blogger": ExtResource("identity_cover_magic")}
